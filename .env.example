# Plantilla sin secretos. scripts/dev-env.py genera .env y el realm local.
SPRING_PROFILES_ACTIVE=dev
ATO_DB_URL=jdbc:postgresql://127.0.0.1:54329/ato
ATO_DB_USER=ato
ATO_DB_PASSWORD=
ATO_KEYCLOAK_ADMIN_PASSWORD=
ATO_OIDC_ISSUER_URI=http://localhost:8180/realms/ato
ATO_OIDC_CLIENT_ID=ato-web
ATO_OIDC_CLIENT_SECRET=
ATO_REQUIRE_MFA=false
ATO_WEB_ORIGIN=http://localhost:3000
# Bootstrap único de desarrollo; en producción queda vacío.
ATO_BOOTSTRAP_MANAGER_EMAIL=gerente@example.invalid

# Cliente de servicio configurado por scripts/configure-account-onboarding.py.
ATO_ACCOUNT_PROVISIONING_ENABLED=false
ATO_ACCOUNT_CLIENT_ID=ato-accounts
ATO_ACCOUNT_CLIENT_SECRET=
ATO_ACCOUNT_ACTIVATION_WORKER_ENABLED=true
# SMTP del proveedor de identidad para verificación/recuperación; independiente del contacto público.
ATO_IDP_SMTP_HOST=
ATO_IDP_SMTP_PORT=587
ATO_IDP_SMTP_FROM=
ATO_IDP_SMTP_AUTH=true
ATO_IDP_SMTP_USER=
ATO_IDP_SMTP_PASSWORD=
ATO_IDP_SMTP_SSL=false
ATO_IDP_SMTP_STARTTLS=true

# M1: el almacenamiento apagado bloquea cargas, sin impedir consultar obras.
# Google Drive: carpeta privada y credenciales OAuth de usuario o Workspace.
ATO_STORAGE_ENABLED=false
ATO_DRIVE_FOLDER_ID=
# Archivo fuera del repositorio o bajo .m0-local/, nunca copiar secretos a Git.
ATO_DRIVE_CREDENTIALS_FILE=
ATO_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
ATO_SCANNER_HOST=127.0.0.1
ATO_SCANNER_PORT=3310
ATO_DOCUMENT_WORKER_ENABLED=true

# M4: configuración sin credenciales reales; no habilitar SMTP hasta completar remitente.
ATO_PUBLIC_ORIGIN=https://atoconstrucciones.com
ATO_MAIL_ENABLED=false
ATO_GMAIL_USERNAME=
ATO_GMAIL_APP_PASSWORD=
ATO_MAIL_RECIPIENT=
ATO_MAIL_SENDER_CONFIRMED=false
ATO_CONTACT_RATE_SECRET=
ATO_CONTACT_TRUSTED_TUNNEL=false
ATO_CONTACT_WORKER_ENABLED=true
