# Copiar fuera de Git a un archivo mode 600. Sin perfiles dev/test.
SPRING_PROFILES_ACTIVE=production
SERVER_ADDRESS=127.0.0.1
ATO_WEB_ORIGIN=https://atoconstrucciones.com
ATO_PUBLIC_ORIGIN=https://atoconstrucciones.com
ATO_BACKEND_ORIGIN=http://127.0.0.1:8080
ATO_DB_URL=jdbc:postgresql://127.0.0.1:5432/ato
ATO_DB_USER=ato
ATO_DB_PASSWORD=
ATO_OIDC_CLIENT_SECRET=
ATO_OIDC_ISSUER_URI=https://atoconstrucciones.com/idp/realms/ato
ATO_BOOTSTRAP_MANAGER_EMAIL=
ATO_REQUIRE_MFA=false
ATO_ACCOUNT_PROVISIONING_ENABLED=false
ATO_ACCOUNT_CLIENT_ID=ato-accounts
ATO_ACCOUNT_CLIENT_SECRET=
ATO_ACCOUNT_ACTIVATION_WORKER_ENABLED=false
# Habilitar tras configurar y ensayar el cliente de servicio y SMTP del IdP; docs/25.
ATO_STORAGE_ENABLED=true
ATO_DRIVE_FOLDER_ID=
ATO_DRIVE_CREDENTIALS_FILE=/etc/ato/secrets/drive.json
ATO_CONTACT_RATE_SECRET=
ATO_CONTACT_TRUSTED_TUNNEL=true
ATO_MAIL_ENABLED=false
ATO_GMAIL_USERNAME=
ATO_GMAIL_APP_PASSWORD=
ATO_MAIL_RECIPIENT=
ATO_MAIL_SENDER_CONFIRMED=false
# Responsable definido en la sesión; configurar aviso en /privacidad sin PII en Git.
# Correo de privacidad, texto definitivo y políticas aún pendientes.
